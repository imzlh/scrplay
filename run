#!/usr/bin/env bash
# Run scrplay generated in the specified BUILDDIR.
#
# This provides the same feature as "ninja run", except that it is possible to
# pass arguments to scrplay.
#
# Syntax: ./run BUILDDIR <scrplay options ...>
if [[ $# = 0 ]]
then
    echo "Syntax: $0 BUILDDIR <scrplay options>" >&2
    exit 1
fi

BUILDDIR="$1"
shift

if [[ ! -d "$BUILDDIR" ]]
then
    echo "The build dir \"$BUILDDIR\" does not exist." >&2
    exit 1
fi

SCRPLAY_ICON_PATH="app/data/icon.png" \
SCRPLAY_SERVER_PATH="$BUILDDIR/server/scrplay-server" \
"$BUILDDIR/app/scrplay" "$@"
